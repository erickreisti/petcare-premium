{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(npm run check)",
      "PowerShell(npm run e2e)",
      "PowerShell(npm run e2e:*)",
      "PowerShell(npx playwright test:*)",
      "PowerShell(npx tsc --noEmit:*)",
      "PowerShell(npx eslint:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
